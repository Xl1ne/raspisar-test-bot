# Токен Telegram-бота, выдаётся @BotFather. В репозиторий не попадает.
BOT_TOKEN=

# Ниже — необязательные настройки. Без них берутся значения по умолчанию из app/config.py.
# Даты учебного семестра (первая неделя учёбы — числитель).
# RASPISAR_STUDY_START=2026-09-01
# RASPISAR_SEMESTER_END=2026-12-27
# Час суточного сбора расписания, по московскому времени.
# RASPISAR_COLLECT_HOUR=3
# Таймаут запроса к источнику, секунд.
# RASPISAR_FETCH_TIMEOUT=15
# Часовой пояс отображения.
# RASPISAR_TZ=Europe/Moscow
# Путь к файлу базы SQLite.
# RASPISAR_DB=data/raspisar.db
# Публичный адрес службы публикации — подставляется в ссылку календаря в боте
# (на демонстрации — адрес туннеля ngrok).
# RASPISAR_PUBLIC_URL=http://localhost:8000
# Напоминание перед занятием: по умолчанию и допустимые границы, минут.
# RASPISAR_REMIND_DEFAULT=60
# RASPISAR_REMIND_MIN=5
# RASPISAR_REMIND_MAX=180
# Не более стольких объявлений в сутки на группу (NFR-08).
# RASPISAR_ANNOUNCE_LIMIT=5
# Как часто планировщик проверяет напоминания и отложенные объявления, секунд.
# RASPISAR_DISPATCH_INTERVAL=60
# На сколько дней вперёд староста может править занятия.
# RASPISAR_EDIT_HORIZON_DAYS=30
# Резервное копирование базы (NFR-10): час по Москве, каталог, сколько копий хранить.
# RASPISAR_BACKUP_HOUR=4
# RASPISAR_BACKUP_DIR=data/backups
# RASPISAR_BACKUP_KEEP=7
